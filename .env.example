# ==============================================================================
# Charles Schwab Developer App Credentials (Required)
# Register your app at https://developer.schwab.com/ (status must be "Ready for Use")
# ==============================================================================
SCHWAB_APP_KEY=your_schwab_app_key
SCHWAB_APP_SECRET=your_schwab_app_secret

# Optional: Must match one of the Callback URLs registered in Schwab Developer Portal.
# - Mode 2 (Local stdio): defaults to https://127.0.0.1:8182
# - Mode 1 (Remote OAuth 2.1 when MCP_PUBLIC_URL is set): defaults to <MCP_PUBLIC_URL>/schwab/callback
SCHWAB_CALLBACK_URL=

# Optional: Default Schwab account number, last 4 digits, or encrypted hashValue
SCHWAB_DEFAULT_ACCOUNT=

# ==============================================================================
# Local Storage & TLS Certificates (Optional)
# By default, files are stored in ~/.config/schwab-mcp/ (shared across all local agents)
# ==============================================================================
# SCHWAB_DATA_DIR=~/.config/schwab-mcp
# SCHWAB_TOKEN_PATH=~/.config/schwab-mcp/token.json
# SCHWAB_AUDIT_LOG_PATH=~/.config/schwab-mcp/trade_audit.jsonl
# MCP_OAUTH_STATE_PATH=~/.config/schwab-mcp/oauth_state.json

# Optional: Trusted local TLS cert/key (e.g. generated with `mkcert 127.0.0.1 localhost`)
# to eliminate browser security warnings during Mode 2 local auto-capture callback.
# SCHWAB_TLS_CERT_PATH=
# SCHWAB_TLS_KEY_PATH=

# ==============================================================================
# Risk & Safety Guardrails (Strongly Recommended)
# ==============================================================================
# Global dry-run guard: when true, all order placements run Schwab previewOrder instead
# of live submission (cannot be overridden by AI tool arguments).
SCHWAB_DRY_RUN=true

# Global read-only guard: when true, blocks live order placement, replacement, and cancellation.
SCHWAB_READ_ONLY=false

# Maximum allowed notional USD value for a single order (applies to equities & options)
SCHWAB_MAX_ORDER_USD=5000.0

# Optional comma-separated whitelist / blacklist of underlying ticker symbols (e.g. AAPL,SPY,NVDA)
SCHWAB_ALLOWED_SYMBOLS=
SCHWAB_BLOCKED_SYMBOLS=

# ==============================================================================
# MCP Transport & Mode 1 Remote Hosting (OAuth 2.1 / Streamable HTTP)
# ==============================================================================
# Transport mode: stdio | streamable-http
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_STREAMABLE_HTTP_PATH=/mcp
MCP_STATELESS_HTTP=false

# Mode 1 (Cloudflare-style Remote OAuth 2.1):
# Set MCP_PUBLIC_URL to your public HTTPS base URL (e.g. https://schwab-mcp.example.com).
# Also register https://schwab-mcp.example.com/schwab/callback in Schwab Developer Portal.
# MCP_PUBLIC_URL=https://schwab-mcp.example.com

# HTTP authentication mode: auto | oauth | bearer | none
# - auto: uses "oauth" if MCP_PUBLIC_URL is set, else "bearer" if MCP_HTTP_AUTH_TOKEN is set, else "none"
MCP_AUTH_MODE=auto

# Optional static Bearer token (used only when MCP_AUTH_MODE=bearer or auto without MCP_PUBLIC_URL)
MCP_HTTP_AUTH_TOKEN=
